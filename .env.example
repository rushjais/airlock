# Copy to .env and fill in. .env is gitignored and never committed.

# ---------------------------------------------------------------------------------------------------------------
# Hosted demo (DEMO_MODE): the ONLY required variable is DATABASE_URL. No model calls (recorded reads are
# replayed), no email or texts, simulated payment rail. Each visitor gets a private sandbox schema.
# ---------------------------------------------------------------------------------------------------------------
DEMO_MODE=1
DATABASE_URL=postgresql://postgres:airlock@localhost:5432/airlock
# Optional tuning (defaults shown)
# AIRLOCK_DB_POOL=8
# AIRLOCK_DEMO_WARM=2                     # sandboxes kept pre-built so a new visitor never waits
# AIRLOCK_DEMO_MAX_SANDBOXES=150
# AIRLOCK_DEMO_IDLE_TTL_S=10800           # idle sandboxes are dropped after 3 hours
# AIRLOCK_DEMO_NEW_PER_IP_HOUR=20         # new sessions per IP per hour
# AIRLOCK_DEMO_ACTIONS_PER_IP_HOUR=150    # clicks per IP per hour
# Optional: a Stripe TEST key makes the demo's executor send real test-mode transfers instead of simulated ones.
# It is passed only to the executor process (see scripts/start.sh). Leave empty for the simulated rail.
# STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Full setup (DEMO_MODE unset): real inbox, real model calls, real texts, Stripe test mode. See README.
# ---------------------------------------------------------------------------------------------------------------
# Invariant 1: STRIPE_SECRET_KEY is read ONLY by the payment executor process (sk_test_... only).
# STRIPE_SECRET_KEY=
# Model (reader / treasurer / reviewer / text Q&A)
# ANTHROPIC_API_KEY=
# AIRLOCK_READER_MODEL=claude-haiku-5-5
# Primitive (the agent's inbox)
# PRIMITIVE_API_KEY=
# PRIMITIVE_WEBHOOK_SECRET=
# AGENT_INBOX_ADDRESS=
# Inkbox (texts to the vendor's phone on file and to the admin)
# INKBOX_API_KEY=
# INKBOX_HANDLE=airlock
# INKBOX_VERIFY_HANDLE=
# AIRLOCK_VERIFY_CHANNEL=text               # text or call
# Admin approval screen
# ADMIN_SESSION_SECRET=
# ADMIN_PASSCODE=
# APP_BASE_URL=http://localhost:5173
# Agent email signing (internal case threads)
# AIRLOCK_AGENT_SIGNING_SECRET=
# Demo phones and emails (real values live only in .env, never in fixtures; the repo is public)
# DEMO_ADMIN_PHONE=
# DEMO_ADMIN_EMAIL=
# DEMO_VENDOR_PHONE_ACME=
# DEMO_VENDOR_PHONE_BRIGHTLINE=
# DEMO_VENDOR_EMAIL_CORVID=
# Bearer token the MCP server uses to call the agent API
# AIRLOCK_MCP_TOKEN=
