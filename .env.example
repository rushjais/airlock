# Copy to .env and fill in. .env is gitignored.
# Invariant 1: STRIPE_SECRET_KEY is read ONLY by the payment executor process.

# Stripe (test mode only — sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Primitive (agent inbox)
PRIMITIVE_API_KEY=
PRIMITIVE_WEBHOOK_SECRET=
AGENT_INBOX_ADDRESS=

# Inkbox (SMS to admin + registered vendor phones)
INKBOX_API_KEY=

# Model (reader / planner)
ANTHROPIC_API_KEY=

# Demo phones (real numbers live only in .env, never in fixtures). Each must enroll with @airlock on iMessage.
DEMO_ADMIN_PHONE=
DEMO_VENDOR_PHONE_ACME=
DEMO_VENDOR_PHONE_BRIGHTLINE=

# Admin approval screen
ADMIN_SESSION_SECRET=
APP_BASE_URL=http://localhost:5173

# Inkbox @airlock SMS number (recipients text START to it once)
INKBOX_AGENT_NUMBER=
AIRLOCK_AGENT_SIGNING_SECRET=
DEMO_ADMIN_EMAIL=
# Bearer token the hosted MCP server uses to call the Airlock agent API
AIRLOCK_MCP_TOKEN=
