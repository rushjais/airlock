# Copy to .env and fill in. .env is gitignored.
# Invariant 1: STRIPE_SECRET_KEY is read ONLY by the payment executor process.

# Stripe (test mode only — sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Primitive (agent inbox)
PRIMITIVE_API_KEY=
PRIMITIVE_WEBHOOK_SECRET=
AGENT_INBOX_ADDRESS=

# Inkbox (SMS to admin + registered vendor phones)
INKBOX_API_KEY=

# Model (reader / planner)
ANTHROPIC_API_KEY=

# Admin approval screen
ADMIN_SESSION_SECRET=
APP_BASE_URL=http://localhost:5173
